<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.daniacosta_dev.AuroraMediaPlayer</id>

  <name>Aurora Media Player</name>
  <summary>Listen to music, watch local and online videos</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
  <p>
    Aurora is a modern media player with a clean GTK4 interface for
    watching videos, listening to music, and opening online media.
  </p>
  <p>
    It supports most common video and audio formats, playlists, subtitle and
    audio track selection, session restore, recent files, album art, and MPRIS
    desktop media controls.
  </p>
</description>

  <developer id="io.github.daniacosta_dev">
    <name>Dani Acosta</name>
  </developer>

  <url type="homepage">https://daniacosta-dev.github.io/aurora-media-player/</url>
  <url type="bugtracker">https://github.com/daniacosta-dev/aurora-media-player/issues</url>
  <url type="vcs-browser">https://github.com/daniacosta-dev/aurora-media-player</url>

  <launchable type="desktop-id">io.github.daniacosta_dev.AuroraMediaPlayer.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Aurora default view</caption>
      <image>https://raw.githubusercontent.com/daniacosta-dev/aurora-media-player/main/data/screenshots/videoplayer1.png</image>
    </screenshot>
    <screenshot>
      <caption>Audio playback</caption>
      <image>https://raw.githubusercontent.com/daniacosta-dev/aurora-media-player/main/data/screenshots/videoplayer2.png</image>
    </screenshot>
    <screenshot>
      <caption>Video playback with controls and playlist</caption>
      <image>https://raw.githubusercontent.com/daniacosta-dev/aurora-media-player/main/data/screenshots/videoplayer3.png</image>
    </screenshot>
  </screenshots>

  <provides>
    <binary>aurora-media</binary>
  </provides>

  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Audio</category>
    <category>Player</category>
    <category>GTK</category>
  </categories>

  <keywords>
    <keyword>media</keyword>
    <keyword>player</keyword>
    <keyword>video</keyword>
    <keyword>audio</keyword>
    <keyword>mpv</keyword>
    <keyword>music</keyword>
    <keyword>youtube</keyword>
  </keywords>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.1.4" date="2026-04-01">
      <description>
        <p>New features and improvements:</p>
        <ul>
          <li>Fullscreen button added to the controls bar</li>
          <li>allow expanded the playlist area</li>
          <li>Close option added to the File menu</li>
          <li>Seek bar thumbnail preview added for local video files</li>
          <li>Player controls centered in floating mode</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-03-25">
      <description>
        <p>New features and improvements:</p>
        <ul>
          <li>Custom color theme: choose your own accent, background, and text/icon colors</li>
          <li>Color pickers with per-color reset button to restore system defaults</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2025-03-25">
      <description>
        <p>Improvements and bug fixes:</p>
        <ul>
          <li>MPRIS album art and artist now work for YouTube streams</li>
          <li>App icon now displays correctly in system media controls</li>
          <li>Recent files list now tracks all played items including auto-advanced tracks</li>
          <li>Opening a recent file moves it to the top of the list</li>
          <li>M3U playlists are no longer added to recent files</li>
          <li>Spanish translation improvements</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2025-01-01">
      <description>
        <p>Initial release of Aurora Media Player.</p>
      </description>
    </release>
  </releases>
</component>
